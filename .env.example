# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (works on Render/Railway, IPv4)
# Example: postgresql://postgres.abcdefghijkl:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Long random secret that signs every fee receipt. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# KEEP IT SAFE AND NEVER CHANGE IT, otherwise old receipts will show as "tampered".
FEE_HMAC_SECRET=

# First admin login (used only when the database has no users yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
# NODE_ENV=production           # set on Render/Railway (makes cookies Secure)
# PORT=4000
# SESSION_HOURS=12
# TRUST_PROXY=2                 # Vercel proxy + Render/Railway proxy
# TZ_NAME=Asia/Kolkata
# DB_SSL_CA=                    # paste Supabase CA certificate for strict SSL verification
# SERVE_FRONTEND=false          # set on Render/Railway (frontend is on Vercel)
